  "cards": [
    {
      "dot": "cyan",
      "title": "Range with today",
      "items": [
        "Totals and the timeline read loaded history",
        "The drain reaches the previous window and 7 days before the range",
        "The comparison cuts the previous window to the same elapsed span"
      ]
    },
    {
      "dot": "amber",
      "title": "Past range",
      "items": [
        "Charts sum /stats/days for the range and its previous window",
        "The timeline reads only its own window, GET /sessions?from&to",
        "If those sessions are already loaded, neither request is made"
      ]
    },
    {
      "dot": "violet",
      "title": "Timeline segments",
      "items": [
        "Clipped to the range and split at local midnight",
        "A session past midnight counts on both days, unlike /stats/days",
        "Over 62 days, only Rhythm draws"
      ]
